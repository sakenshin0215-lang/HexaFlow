{
  "task_name": "okx_web3_connect_wallet_demo",
  "goal": "打开 OKX Web3 页面, 然后点击RIVER代币进入详细页面，然后在交易框输入0.01个币值",
  "notes": [
    "如果页面是 SPA 或跨域跳转，优先等待关键 DOM 出现后再点击",
    "遇到弹窗优先尝试关闭、跳过或确认",
    "尽量不要重复点击同一元素"
  ],
  "start_url": "https://www.okx.com/web3",
  "manual_review": false,
  "max_steps": 20,
  "allowed_domains": [
    "okx.com",
    "web3.okx.com"
  ],
  "blocked_keywords": [
    "下载APP",
    "立即购买",
    "订阅"
  ],
  "failure_policy": {
    "mode": "stop",
    "max_consecutive_failures": 4
  },
  "risky_actions_policy": {
    "enabled": true,
    "mode": "require_confirm",
    "keywords": [
      "确认",
      "提交",
      "购买",
      "卖出",
      "转账",
      "提现",
      "发送",
      "授权",
      "approve",
      "sign",
      "swap",
      "connect wallet"
    ],
    "allowed_domains": [
      "okx.com",
      "web3.okx.com"
    ],
    "allowed_url_contains": [
      "okx.com/web3"
    ],
    "max_confirm_wait_seconds": 900
  },
  "success_criteria": {
    "mode": "any",
    "criteria": [
      {
        "type": "text_present",
        "value": "0.01",
        "case_insensitive": true
      }
    ],
    "check_every_step": true,
    "max_wait_ms": 0
  },
  "loop_policy": {
    "enabled": true,
    "loop_name": "main_loop",
    "iterations": 10,
    "max_iteration_retries": 30
  }
}
